---
import { Image } from "astro:assets";
interface Props {
    text: string;
    url?: string;
    icon?: string | ImageMetadata;
    /**
     * Optional tooltip
     */
    title?: string;
}

const { text, url, icon, title } = Astro.props;
---

<a
    href={url}
    class="flex flex-col items-center rounded-md border-2 border-neutral-600 bg-neutral-700 px-3 py-2 text-lg font-medium duration-150 ease-in-out hover:bg-neutral-500"
    {title}
    ><div class="flex flex-row items-center">
        {
            icon && typeof icon !== "string" ? (
                <Image src={icon} alt={text} width={20} height={20} class="mr-2 h-5 w-5 rounded-xs" />
            ) : icon && typeof icon === "string" ? (
                <img src={icon} alt={text} class="mr-2 h-5 w-5 rounded-xs" />
            ) : null
        }
        <span class:list={[{ underline: title !== undefined }]}>{text}</span>
    </div>
</a>
