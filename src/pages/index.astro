---
import color from "../scripts/colors.json";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillContainer from "../components/SkillContainer.astro";
import SkillCard from "../components/SkillCard.astro";
import SocialCard from "../components/SocialCard.astro";

import mongodbLogo from "../assets/icons/mongodb.svg";
import { Icon } from "astro-icon/components";
---

<Layout page="home">
    <div class="mx-auto my-10 flex max-w-screen flex-col justify-center px-4 lg:max-w-4xl lg:px-0">
        <h1 class="text-3xl font-bold">hi, i'm <span class="text-red-400">alden!</span></h1>
        <p class="text-neutral-200">
            17-year-old <span class="text-red-400">Software Engineering student</span> and <span class="text-red-400"
                >self-taught developer</span
            > from Indonesia.
        </p>
        <hr class="my-8" />
        <h2 id="about-me" class="mr-6 pb-6 text-2xl font-semibold">About Me</h2>
        <section class="mb-4 rounded-md border-2 border-neutral-600 bg-neutral-800 p-3">
            <p class="text-lg">
                I am a <span class="underline decoration-zinc-500 underline-offset-2"
                    >Software Engineering (RPL) student</span
                > from Indonesia at SMKN 1 Jenangan and a <span class="underline decoration-zinc-500 underline-offset-2"
                    >self-taught developer since 2020</span
                >. I mostly do server-side stuff like Discord bots, but I also enjoy exploring networking, game modding,
                electronics, and tech stuff in general.
                <!-- Most of my projects go unfinished because I get bored of them easily or I don't have the
                time to continue them, so they never get published. I'm currently re-visiting fundamentals at school
                while focusing on more advanced personal projects. -->
            </p>
        </section>
        <section class="flex flex-col gap-4 lg:flex-row">
            <div
                class="mb-0 flex w-full justify-center rounded-md border-2 border-neutral-600 bg-neutral-800 p-3 lg:mb-4 lg:w-1/3"
            >
                <div class="flex items-center space-x-2">
                    <Icon class="text-xl" name="mdi:clock" />
                    <span class="text-neutral-500">UTC+7</span><span id="clock" class="w-16 text-start"></span>
                </div>
            </div>
            <div
                class="mb-0 flex w-full justify-center rounded-md border-2 border-neutral-600 bg-neutral-800 p-3 lg:mb-4 lg:w-1/3"
            >
                <div class="flex items-center space-x-2">
                    <Icon class="text-xl" name="mdi:calendar" />
                    <span id="date" class=""></span>
                </div>
            </div>
            <a
                href="/projects"
                class="mb-0 flex w-full justify-between rounded-md border-2 border-red-600 bg-red-900 p-3 duration-150 ease-in-out hover:bg-red-700 lg:mb-4 lg:w-1/3"
            >
                <div class="flex items-center space-x-2">
                    <Icon class="text-xl" name="mdi:document" /><span>Projects</span>
                </div>
                <Icon class="text-xl" name="mdi:arrow-top-right" />
            </a>
        </section>
        <h2 id="socials" class="mr-6 py-6 text-2xl font-semibold">Socials</h2>
        <section class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            <SocialCard platform="GitHub" username="aldenasf" url="https://github.com/aldenasf">
                <Icon class="mr-2 text-2xl" name="fa6-brands:github" />
            </SocialCard>
            <SocialCard platform="Discord" username="aldenasf" url="https://discord.com/users/529424782438170679">
                <Icon class="mr-2 text-2xl" name="fa6-brands:discord" />
            </SocialCard>
            <SocialCard platform="AniList" username="aldenasf" url="https://anilist.co/user/aldenasf">
                <div class="mr-2 text-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none"></path>
                        <path
                            fill="currentColor"
                            d="M24 17.53v2.421c0 .71-.391 1.101-1.1 1.101h-5l-.057-.165L11.84 3.736c.106-.502.46-.788 1.053-.788h2.422c.71 0 1.1.391 1.1 1.1v12.38H22.9c.71 0 1.1.392 1.1 1.101zM11.034 2.947l6.337 18.104h-4.918l-1.052-3.131H6.019l-1.077 3.131H0L6.361 2.948h4.673zm-.66 10.96l-1.69-5.014l-1.541 5.015h3.23z"
                        ></path>
                    </svg>
                </div>
            </SocialCard>
        </section>
        <h2 id="projects" class="mr-6 py-6 text-2xl font-semibold">Projects</h2>
        <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <ProjectCard
                author="aldenasf"
                repo="unicode-spoofer"
                description="📝 Replace Latin characters with visually similar Unicode alternatives from other scripts"
                language="TypeScript"
                url="https://github.com/aldenasf/unicode-spoofer"
            /><ProjectCard
                author="aldenasf"
                repo="personal-site"
                description="🚀 personal website"
                language="Astro"
                url="https://github.com/aldenasf/personal-site"
            />
            <ProjectCard
                author="AlkaUtilities"
                repo="metal-pipe-player"
                description="A Discord bot that repeatedly plays an audio file in a random interval"
                language="JavaScript"
                url="https://github.com/AlkaUtilities/metal-pipe-player"
            />
            <ProjectCard
                author="AlkaUtilities"
                repo="carbon"
                description="silly general purpose discord bot"
                language="TypeScript"
                url="https://github.com/AlkaUtilities/carbon"
            />
        </section>
        <h2 class="mr-6 py-6 text-2xl font-semibold">Tech Stack</h2>
        <section class="flex flex-col">
            <SkillContainer text="Backend">
                <SkillCard
                    text="Node.js"
                    icon="https://nodejs.org/static/logos/jsIconGreen.svg"
                    url="https://nodejs.org/"
                />
                <SkillCard
                    text="TypeScript"
                    icon="https://upload.wikimedia.org/wikipedia/commons/f/f5/Typescript.svg"
                    url="https://www.typescriptlang.org/"
                />
                <SkillCard
                    text="Python"
                    icon="https://s3.dualstack.us-east-2.amazonaws.com/pythondotorg-assets/media/files/python-logo-only.svg"
                    url="https://python.org/"
                />
                <SkillCard
                    text="Discord.js"
                    icon="https://avatars.githubusercontent.com/u/26492485?s=200&v=4"
                    url="https://discord.js.org/"
                />
            </SkillContainer>
            <SkillContainer text="Frontend">
                <SkillCard
                    text="HTML"
                    icon="https://www.w3.org/html/logo/downloads/HTML5_Badge.svg"
                    url="https://en.wikipedia.org/wiki/HTML"
                />
                <SkillCard
                    text="CSS"
                    icon="https://upload.wikimedia.org/wikipedia/commons/a/ab/Official_CSS_Logo.svg"
                    url="https://en.wikipedia.org/wiki/CSS"
                />
                <SkillCard
                    text="JavaScript"
                    icon="https://upload.wikimedia.org/wikipedia/commons/6/6a/JavaScript-logo.png"
                    url="https://en.wikipedia.org/wiki/JavaScript"
                />
                <SkillCard
                    text="Astro"
                    icon="https://astro.build/assets/press/astro-icon-light-gradient.svg"
                    url="https://astro.build/"
                />
                <SkillCard
                    text="Tailwind CSS"
                    icon="https://upload.wikimedia.org/wikipedia/commons/d/d5/Tailwind_CSS_Logo.svg"
                    url="https://tailwindcss.com/"
                />
            </SkillContainer>
            <SkillContainer text="Tools">
                <SkillCard
                    text="pnpm"
                    icon="data:image/svg+xml;base64,"
                    url="https://pnpm.io/"
                />
                <SkillCard
                    text="Git"
                    icon="https://git-scm.com/images/logos/downloads/Git-Icon-1788C.svg"
                    url="https://git-scm.com/"
                />
            </SkillContainer>
        </section>
    </div>
</Layout>

<script>
    function updateDate() {
        const date = new Date().toLocaleDateString("en-US", {
            timeZone: "Asia/Jakarta",
            year: "numeric",
            month: "long",
            day: "numeric",
        });
        const dateElem = document.getElementById("date");
        if (dateElem) {
            dateElem.textContent = `${date}`;
        }
    }

    function updateClock() {
        const time = new Date().toLocaleTimeString("en-US", {
            timeZone: "Asia/Jakarta",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
        });
        const clockElem = document.getElementById("clock");
        if (clockElem) {
            clockElem.textContent = `${time}`;
        }
    }
    updateDate();
    updateClock();
    setInterval(updateClock, 1000);
</script>
